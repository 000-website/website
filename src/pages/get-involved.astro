---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const contactEmail = "contact@axeldevelops.com";
---

<BaseLayout title="Get involved — 000.website">
  <Header />

  <main class="wrap page">
    <section class="contact-hero">
      <h1 class="display">
        YOUR PLACE
        <br />
        ONLINE
        <br />
        <span class="accent">STARTS HERE</span>
      </h1>

      <div class="contact-intro">
        <p class="lead">
          This is a call to small businesses, independent communities and
          non-profit associations.
        </p>

        <p>
          If you have a meaningful project that could use a home on the web,
          we'd like to hear about it. Tell us what you do, who you want to
          reach, and what you imagine your website could be.
        </p>

        <a
          class="button"
          href={`mailto:${contactEmail}?subject=${encodeURIComponent("A project for 000.website")}`}
        >
          Start a conversation
        </a>
      </div>
    </section>

    <section class="note">
      <span class="mono">A QUICK NOTE</span>

      <p>
        We work on a limited number of projects and prioritize small
        organizations that would otherwise struggle to afford a website.
        <br />
        <br />
        *Free means no development and maintenance fee. Any optional third-party
        costs, such as a custom domain, will be discussed clearly in advance.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page {
    padding-top: 50px;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    /* align-items: end; */
    gap: 50px;
    padding-bottom: 100px;
  }

  .contact-hero h1 {
    font-size: clamp(4rem, 8vw, 9rem);
    margin: 0;
  }

  .contact-intro {
    padding-bottom: 12px;
    max-width: 480px;
  }

  .lead {
    font-size: clamp(1.5rem, 2.2vw, 2.2rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin: 0 0 28px;
  }

  .contact-intro p:not(.lead) {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 30px;
  }

  .note {
    margin: 0 0 100px;
    padding: 30px;
    background: #dedbd2;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 30px;
  }

  .note p {
    max-width: 650px;
    line-height: 1.6;
    margin: 0;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .contact-hero {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .contact-intro {
      margin-left: auto;
      max-width: 550px;
    }
  }

  @media (max-width: 700px) {
    .page {
      padding-top: 45px;
    }

    .contact-hero {
      gap: 35px;
      padding-bottom: 70px;
    }

    .contact-hero h1 {
      font-size: clamp(3.7rem, 15vw, 7rem);
    }

    .contact-intro {
      margin-left: 0;
    }

    .lead {
      font-size: 2rem;
    }

    .note {
      grid-template-columns: 1fr;
      margin-bottom: 70px;
      padding: 22px;
    }
  }
</style>
