---
import "../styles/global.css";
const {
  title = "000.website — The web is for everyone",
  description = "Free, independent websites for small businesses, communities, and non-profits.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body style={{ maxWidth: "800px", justifySelf: "center" }}>
    <slot />
  </body>
</html>
